    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#d3aad59e1b41a85c0e44cec74af06af5d1c1b0b5",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.562.0",
