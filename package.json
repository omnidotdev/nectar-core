{
  "name": "@omnidotdev/nectar-core",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./server": {
      "types": "./build/server.d.ts",
      "import": "./build/server.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "check": "biome check --diagnostic-level=error src",
    "lint": "biome lint",
    "format": "biome format --write",
    "knip": "knip-bun --tags=-knipignore",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.17",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
